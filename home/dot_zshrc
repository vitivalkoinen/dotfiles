# ~/.zshrc

# パス設定
export PATH="$HOME/.local/bin:$PATH"
export PATH=$PATH:/opt/nvim

# Sheldonの初期化（設定ファイルが無い環境ではエラーになるためスキップ）
# compinit は zsh-completions の fpath 追加後に実行する必要があるため、plugins.toml 側で実行する。
if [[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/sheldon/plugins.toml" ]] && (( $+commands[sheldon] )); then
  eval "$(sheldon source)"
else
  autoload -Uz compinit && compinit
fi

# zsh-history-substring-search: 上下キーで入力中の文字列を含む履歴を検索
if (( $+widgets[history-substring-search-up] )); then
  bindkey '^[[A' history-substring-search-up
  bindkey '^[[B' history-substring-search-down
  bindkey -M emacs '^P' history-substring-search-up
  bindkey -M emacs '^N' history-substring-search-down
fi

# Starshipプロンプト
eval "$(starship init zsh)"
source /usr/share/doc/fzf/examples/key-bindings.zsh
source /usr/share/doc/fzf/examples/completion.zsh

# 基本的なZshオプション
setopt AUTO_CD
setopt CORRECT
setopt HIST_VERIFY
setopt SHARE_HISTORY
setopt APPEND_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE

# 履歴設定
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000

# WSL設定
# wsluパッケージ(wslview)には依存せず、~/.local/bin/wslview(実行可能スクリプト)で代替する。
# gh等の外部プログラムからexecされてもBROWSERが機能するよう、シェル関数ではなく実行ファイルにしている。
if grep -qi microsoft /proc/version 2>/dev/null; then
  export BROWSER=wslview
fi

# 言語ごとのバージョン管理
# - Node.js / Go: mise（~/.config/mise/config.toml）
# - Python: uv（~/.local/bin に配置済みのため追加設定なし）
# - Rust: rustup
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi

# Go設定（GOROOT は mise が設定するため、ここでは指定しない）
export GOPATH=$HOME/.go
export PATH=$PATH:$GOPATH/bin

# Rust設定（rustup 未インストールならスキップ）
[[ -f ~/.cargo/env ]] && source ~/.cargo/env

# zoxide (ディレクトリジャンプ)
eval "$(zoxide init zsh)"
# Claude Code内ではフックが引き継がれず警告が出るため抑止
if [[ -n "$CLAUDECODE" ]]; then
  export _ZO_DOCTOR=0
fi

# エイリアス
alias ls='eza'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'
alias cd='z'
alias ..='cd ..'
alias ...='cd ../..'
alias cat='batcat --paging=never'
alias vim='nvim'

# Git エイリアス
alias gs='git status'
alias ga='git add'
alias gc='git commit'
alias gp='git push'
alias gl='git log --oneline --graph'
alias gco='git checkout'
alias gb='git branch'
alias gd='git diff'

# ghq
function ghq-fzf_change_directory() {
    # 選択したリポジトリへ移動 かつ
    # 右にリポジトリのディレクトリ詳細を表示
  local src=$(ghq list | fzf --preview "eza -l -g -a --icons $(ghq root)/{} | tail -n+4 | awk '{print \$6\"/\"\$8\" \"\$9 \" \" \$10}'")
  if [ -n "$src" ]; then
    BUFFER="cd $(ghq root)/$src"
    zle accept-line
  fi
  zle -R -c
}

zle -N ghq-fzf_change_directory
bindkey '^]' ghq-fzf_change_directory
